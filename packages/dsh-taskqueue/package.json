{
  "name": "@ericality/dsh-taskqueue",
  "version": "0.12.1",
  "description": "Client-level task queue for DSH: park non-urgent prompts, then auto-dispatch them during off-peak (cheap) windows, at a scheduled time, or right after a host restart; includes the editable queue panel RPC, the off-peak travel mode, the step-boundary pause gate, and configurable dispatch prefix/suffix templates.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dshCompat": {
    "host": "^0.1.2-rc.1 || ^0.2.2-rc.1",
    "seams": [
      "sessionEvents",
      "sessionAppend",
      "eventTypeRegistry",
      "rpcHandle",
      "commands",
      "tools",
      "agents"
    ],
    "blocked": [
      "eventTypeRegistry",
      "agents"
    ]
  },
  "dependencies": {
    "@ericality/dsh-banner-kit": "0.1.0",
    "@ericality/dsh-cost-tier": "0.1.0",
    "@ericality/dsh-host-compat": "0.1.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ericality/dsh-enhanced.git"
  },
  "homepage": "https://github.com/Ericality/dsh-enhanced",
  "publishConfig": {
    "access": "public"
  }
}
