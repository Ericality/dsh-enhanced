{
  "name": "@ericality/dsh-host-compat",
  "version": "0.1.2",
  "description": "插件共享底座：宿主能力探测 + 三态 (OK/DEGRADED/BLOCKED) + seam 纯函数库 + 适配状态聚合 + /host-compat RPC + 降级横幅；v0.1.2 增补 r6 agentTeams 能力键与 teamMemberOf seam（Agent Teams 团队成员判定，R7 中间件单点）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./seams": "./lib/seams.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dshCompat": {
    "host": "^0.2.2-rc.1",
    "seams": [
      "sessionEvents",
      "sessionAppend",
      "eventTypeRegistry",
      "rpcHandle"
    ]
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  }
}
