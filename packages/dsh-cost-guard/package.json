{
  "name": "@ericality/dsh-cost-guard",
  "version": "0.3.2",
  "description": "回合结束费用提醒：保守/激进双阈值 + 未来回合预测 + 子 agent 树累计，阈值可在插件配置页调整。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dshCompat": {
    "host": "^0.2.2-rc.1",
    "seams": [
      "sessionEvents",
      "sessionAppend",
      "eventTypeRegistry",
      "projcache",
      "rpcHandle",
      "commands"
    ],
    "blocked": [
      "eventTypeRegistry"
    ]
  },
  "dependencies": {
    "@ericality/dsh-banner-kit": "0.1.0",
    "@ericality/dsh-host-compat": "0.1.1",
    "@ericality/dsh-cost-pricing": "0.1.0",
    "@ericality/dsh-cost-tree": "0.1.1",
    "@ericality/dsh-reconcile": "0.1.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  }
}
