{
  "name": "@ericality/dsh-sessions-cost",
  "version": "0.2.1",
  "description": "按时间窗口统计各会话费用，按高峰与低谷分别计价，结果以可折叠横幅展示。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "@ericality/dsh-banner-kit": "0.1.0",
    "@ericality/dsh-host-compat": "0.1.1",
    "@ericality/dsh-cost-pricing": "0.1.0",
    "@ericality/dsh-cost-tree": "0.1.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  }
}
