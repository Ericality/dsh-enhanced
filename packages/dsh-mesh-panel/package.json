{
  "name": "@ericality/dsh-mesh-panel",
  "version": "0.5.7",
  "description": "多端互联面板：双向配对、证书指纹钉住、对端只读日志与地址自动校正。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dshCompat": {
    "host": "^0.2.2-rc.1",
    "seams": [
      "rpcHandle",
      "webServerPrefix",
      "webServerUpgrade"
    ]
  },
  "dependencies": {
    "@ericality/dsh-host-compat": "0.1.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ericality/dsh-enhanced.git",
    "directory": "packages/dsh-mesh-panel"
  },
  "homepage": "https://github.com/ericality/dsh-enhanced#readme",
  "publishConfig": {
    "access": "public"
  }
}
