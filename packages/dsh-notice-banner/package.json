{
  "name": "@ericality/dsh-notice-banner",
  "version": "0.11.7",
  "description": "把费用、队列、通知、账本等事件渲染成可折叠的会话横幅卡。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dshCompat": {
    "host": "^0.2.2-rc.1",
    "seams": [
      "eventTypeRegistry"
    ],
    "blocked": [
      "eventTypeRegistry"
    ]
  },
  "dependencies": {
    "@ericality/dsh-banner-kit": "0.1.0",
    "@ericality/dsh-host-compat": "0.1.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "data",
    "locale",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
