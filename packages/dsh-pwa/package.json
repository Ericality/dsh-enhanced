{
  "name": "@ericality/dsh-pwa",
  "version": "0.1.1",
  "description": "移动端主屏安装：apple-touch-icon、独立窗口与 PWA 清单。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  }
}
