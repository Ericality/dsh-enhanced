{
  "name": "@ericality/dsh-balance",
  "version": "0.1.2",
  "description": "余额与费用看板：/balance、/balance-detail 与 /cost 命令，展示实时余额、用量差值与费用估算。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "@ericality/dsh-banner-kit": "0.1.0",
    "@ericality/dsh-host-compat": "0.1.1",
    "@ericality/dsh-cost-pricing": "0.1.0",
    "@ericality/dsh-cost-tree": "0.1.1",
    "@ericality/dsh-reconcile": "0.1.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  }
}
